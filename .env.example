# Copy to .env (never commit .env). Public addresses only; no secrets are needed to run the server.
X402_NETWORK=devnet                 # devnet | mainnet
PAY_TO=<your Solana address that receives USDC>
FACILITATOR_URL=https://x402.org/facilitator          # devnet. Mainnet: https://facilitator.payai.network
PRICE_TOKEN_CHECK=$0.005
PRICE_TOKEN_CHECK_BATCH=$0.01
PORT=4021
PUBLIC_BASE_URL=https://<your-public-origin>
DATA_RPC_URLS=https://solana-rpc.publicnode.com       # comma-separated failover list
# Also accept USDC on Base mainnet (eip155:8453). Needs a facilitator that supports Base, e.g. PayAI on mainnet; keep 0 for devnet.
BASE_ACCEPTS=0
BASE_PAY_TO=<your Base address that receives USDC>
# Optional: paid holder lookups via QuickNode x402 ($0.001/call) from a separate low-balance wallet file
# QN_WALLET_FILE=/path/outside/repo/qn_rpc_wallet.json
# QN_LOG_FILE=/path/outside/repo/qn_spend.log
# QN_DAILY_CAP=100
